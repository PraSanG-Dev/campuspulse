# Backend environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# The ANON key is safe to use for user-scoped operations when RLS is on.
# We forward the user's JWT, so we NEVER need the service-role key here.
SUPABASE_ANON_KEY=your-anon-key-here

# Used to verify incoming JWTs from the frontend.
# From Supabase project → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider: "google" (Gemini — free tier), "openai", or "anthropic"
LLM_PROVIDER=google
# Get your free Gemini key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=your-gemini-api-key-here
# Model name
LLM_MODEL=gemini-1.5-flash

# ── App settings ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173
# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760
# Max pages allowed per PDF
MAX_PDF_PAGES=50
